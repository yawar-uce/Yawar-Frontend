{
  "name": "yawar-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "shared",
    "desktop",
    "mobile"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @yawar/web",
    "lint": "eslint .",
    "e2e": "npm run e2e --workspace @yawar/web",
    "test": "vitest run --coverage",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
